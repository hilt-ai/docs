{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "Hilt",
  "description": "Data Movement Governance for modern infrastructure.",
  "colors": {
    "primary": "#166E3F",
    "light": "#26BD6C",
    "dark": "#166E3F"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/logo/hilt-logo.png",
