              "data/networks",
              "data/files",
              "data/users",
              "data/activity",
              "data/credentials"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "security/anomalies",
              "security/alerts",
              "security/exposure",
              "security/malware",
              "security/frameworks",
              "security/quarantine"
            ]
          },
          "why-hilt",
          "integrations"
        ]
      }
    ]
  },
  "footer": {},
  "redirects": [
    {
      "source": "/endpoint-security",
      "destination": "/security/malware",
      "permanent": true
    }
  ]
